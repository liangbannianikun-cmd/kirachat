# Testnet defaults. Use a private provider URL in production.
RPC_URL=https://sepolia.base.org
EXPECTED_CHAIN_ID=84532
EXPLORER_URL=https://sepolia-explorer.base.org

# Deployment only. Keep the owner separate from the online issuer in production.
DEPLOYER_PRIVATE_KEY=0x...
ISSUER_ADDRESS=0x...

# Runtime.
CONTRACT_ADDRESS=0x...
ISSUER_PRIVATE_KEY=0x...
POINTS_HMAC_SECRET=replace-with-at-least-32-random-characters
PORT=8788
DATA_FILE=./data/points.json
DAILY_CHECKIN_POINTS=10

# CC token deployment. CC_SYMBOL must be final before deployment.
CC_NAME=CC Coin
CC_SYMBOL=CC
EMISSION_START_TIME=1798761600
ROOT_PUBLISHER_ADDRESS=0x...
FINAL_ADMIN_ADDRESS=0x...
# Only enable after verifying the final multisig controls both contracts.
RENOUNCE_DEPLOYER=false
