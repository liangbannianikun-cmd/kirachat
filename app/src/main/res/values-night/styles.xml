<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MiuTavern" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/miuix_background</item>
        <item name="android:textColorPrimary">@color/miuix_text_primary</item>
        <item name="android:textColorSecondary">@color/miuix_text_secondary</item>
        <item name="colorControlNormal">@color/miuix_text_secondary</item>
        <item name="colorControlActivated">@color/wechat_green</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/wechat_green</item>
        <item name="android:navigationBarColor">@color/miuix_background</item>
        <item name="android:statusBarColor">@color/miuix_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="27">@color/miuix_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
